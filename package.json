{
  "name": "openmathpix",
  "version": "2026.11.11",
  "license": "AGPL-3.0-only",
  "description": "Open-source formula snipping tool with local MFR-1.5, LaTeX-OCR and PaddleOCR engines",
  "main": "./out/main/index.js",
  "author": {
    "name": "Wei Zhuo",
    "email": "jhuow@proton.me",
    "url": "https://wei2hu0.github.io/"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run version:check && electron-vite build && electron-builder --win nsis --x64 --publish never",
    "icons": "node scripts/build-icons.cjs",
    "lint": "eslint .",
    "format:check": "prettier --check src tests *.json *.ts *.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "check": "npm run version:check && npm run typecheck && npm run lint && npm test && npm run build",
    "version:check": "node scripts/check-release.cjs"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "electron-store": "^8.2.0",
    "katex": "^0.16.0",
    "onnxruntime-node": "1.31.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "sharp": "0.35.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "eslint": "^9.0.0",
    "mathjax-full": "3.2.2",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JhuoW/OpenMathpix.git"
  }
}
